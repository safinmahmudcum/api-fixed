# ──────────────────────────────────────────────
# sh-checker-api — Environment Configuration
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────

# Port the gunicorn server listens on (nginx proxies to this)
PORT=5002

# Number of gunicorn worker processes (rule of thumb: 2 * CPU cores + 1)
WORKERS=4

# Optional: if you want to lock down the API with a simple token check,
# set this and validate request.headers.get("X-Api-Key") in server.py
# API_KEY=your_secret_key_here
